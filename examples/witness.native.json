{
  "listen": "0.0.0.0:9443",
  "certificate": "/etc/vault/witness.crt",
  "database": "/state/witness.db",
  "backend": {
    "kind": "native",
    "signing": {
      "kind": "snp",
      "endpoint": "https://REPLACE_WITH_INDEPENDENT_CUSTODIAN/",
      "ca": "/etc/vault/custodian-ca.pem",
      "key_id": "witness-sign",
      "public_key": "REPLACE_WITH_BASE64URL_COMPRESSED_P256_PUBLIC_KEY"
    },
    "decryption": {
      "kind": "snp",
      "endpoint": "https://REPLACE_WITH_INDEPENDENT_CUSTODIAN/",
      "ca": "/etc/vault/custodian-ca.pem",
      "key_id": "witness-storage",
      "public_key": "p256:REPLACE_WITH_BASE64URL_UNCOMPRESSED_P256_PUBLIC_KEY"
    }
  },
  "operator_public_key": "REPLACE_WITH_PINNED_VAULT_OPERATOR_KEY",
  "tls_signing": {
    "kind": "snp",
    "endpoint": "https://REPLACE_WITH_INDEPENDENT_CUSTODIAN/",
    "ca": "/etc/vault/custodian-ca.pem",
    "key_id": "witness-tls",
    "public_key": "REPLACE_WITH_BASE64URL_COMPRESSED_P256_PUBLIC_KEY"
  }
}
