{
  "listen": "127.0.0.1:9443",
  "certificate": "/etc/vault-rs/witness.crt",
  "tls_key": "/etc/vault-rs/witness.key",
  "database": "/var/lib/vault-rs/witness.db",
  "backend": {
    "kind": "native",
    "signing": {
      "helper": "/usr/local/libexec/vault-native-key",
      "helper_sha256": "REPLACE_WITH_VERIFIED_HELPER_SHA256",
      "key_id": "witness-sign",
      "public_key": "REPLACE_WITH_BASE64URL_COMPRESSED_P256_PUBLIC_KEY"
    },
    "decryption": {
      "helper": "/usr/local/libexec/vault-native-key",
      "helper_sha256": "REPLACE_WITH_VERIFIED_HELPER_SHA256",
      "key_id": "witness-storage",
      "public_key": "p256:REPLACE_WITH_BASE64URL_UNCOMPRESSED_P256_PUBLIC_KEY"
    }
  },
  "operator_public_key": "REPLACE_WITH_PINNED_VAULT_OPERATOR_KEY"
}
