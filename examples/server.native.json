{
  "listen": "0.0.0.0:8443",
  "certificate": "/etc/vault/server.crt",
  "database": "/state/vault.db",
  "backend": {
    "kind": "native",
    "signing": {
      "kind": "snp",
      "endpoint": "https://REPLACE_WITH_INDEPENDENT_CUSTODIAN/",
      "ca": "/etc/vault/custodian-ca.pem",
      "key_id": "witness-operator-sign",
      "public_key": "REPLACE_WITH_BASE64URL_COMPRESSED_P256_PUBLIC_KEY"
    },
    "decryption": {
      "kind": "snp",
      "endpoint": "https://REPLACE_WITH_INDEPENDENT_CUSTODIAN/",
      "ca": "/etc/vault/custodian-ca.pem",
      "key_id": "guardian-ecdh",
      "public_key": "p256:REPLACE_WITH_BASE64URL_UNCOMPRESSED_P256_PUBLIC_KEY"
    }
  },
  "trust": {
    "vault": "00000000-0000-0000-0000-000000000001",
    "audience": "https://localhost:8443",
    "issuer": "https://REPLACE_WITH_AUTHORIZATION_SERVER",
    "issuer_public_key": "REPLACE_WITH_PINNED_ISSUER_KEY",
    "owner_public_key": "REPLACE_WITH_PINNED_OWNER_KEY"
  },
  "witness_url": "https://REPLACE_WITH_INDEPENDENT_WITNESS/v1/witness",
  "witness_public_key": "REPLACE_WITH_PINNED_WITNESS_KEY",
  "witness_ca": "/etc/vault/witness-ca.pem",
  "postgres": {
    "connection_envelope": "/etc/vault/provider.encrypted.json",
    "ca": "/etc/vault/postgres-ca.pem",
    "policy": {
      "provider": "postgres",
      "role": "report_reader",
      "max_ttl_seconds": 300
    }
  },
  "tls_signing": {
    "kind": "snp",
    "endpoint": "https://REPLACE_WITH_INDEPENDENT_CUSTODIAN/",
    "ca": "/etc/vault/custodian-ca.pem",
    "key_id": "server-tls",
    "public_key": "REPLACE_WITH_BASE64URL_COMPRESSED_P256_PUBLIC_KEY"
  }
}
